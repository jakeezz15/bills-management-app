{
  "expo": {
    "name": "On Hand",
    "slug": "bills-management-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "billsmanagementapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.durantetechsolutions.onhand"
    },
    "android": {
      "package": "com.durantetechsolutions.onhand",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 128
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F172A",
          "defaultChannel": "due-reminders",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-status-bar",
        {
          "style": "light"
        }
      ],
      "@react-native-vector-icons/ionicons",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9acb7580-8e04-4b4b-949d-ce146c271c5e"
      }
    },
    "owner": "jakeezz15"
  }
}
